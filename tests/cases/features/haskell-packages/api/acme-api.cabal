cabal-version: 3.0
name:          acme-api
version:       0.1.0.0

common shared
  default-language: GHC2021
  build-depends:    base >=4.18 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Acme.Api
                    Acme.Api.Routes
  build-depends:    acme-core

executable acme-api
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    acme-api

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  build-depends:    acme-api, acme-core
