$ zenith suggest
exit: 0
--- stderr
warning: found no new contracts to suggest that the code keeps

$ zenith suggest --config taken.toml
exit: 0
--- stdout
# The top-level directories depend on each other in no cycle.
[contracts.directories-acyclic]
type = "acyclic"
modules = ["app", "db", "domain", "jobs", "logging"]

# These top-level directories stack in layers: each depends only on the layers below it.
[contracts.directories-layers-2]
type = "layers"
layers = ["app | jobs", "domain", "db | logging"]

