$ zenith suggest
exit: 0
--- stdout
# The workspace packages depend on each other in no cycle.
[contracts.packages-acyclic]
type = "acyclic"
modules = ["pkg:*"]

# These workspace packages stack in layers: each depends only on the layers below it.
[contracts.packages-layers]
type = "layers"
layers = [
    "pkg:@independence/admin | pkg:@independence/web",
    "pkg:@independence/ui",
    "pkg:@independence/utils",
]

# The workspace packages in `apps` do not depend on each other.
[contracts.apps-independent]
type = "independence"
modules = ["pkg:@independence/admin", "pkg:@independence/web"]

$ zenith check --config suggested.toml
exit: 0
--- stdout
Contracts
  ✓ packages-acyclic  acyclic       kept
  ✓ packages-layers   layers        kept
  ✓ apps-independent  independence  kept

3 kept, 0 broken · 4 files, 3 imports

