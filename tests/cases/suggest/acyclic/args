# `app` imports `ui` and `utils`, which import nothing: no cycle, and they
# stack in layers, `ui` and `utils` side by side below `app`. The packages in
# `packages` depend on each other, so they are not independent. `pkg:*`
# selects every package, so it covers the packages added later too.
suggest
# `suggested.toml` holds what `suggest` printed, which the code keeps.
check --config suggested.toml
